    "defName": "EggMegabeeFertilized",
    "xpath": "label",
    "key": "EggMegabeeFertilized.label",
    "english": "megabee egg (fert.)"
  },
  {
    "file": "Mod/Defs/ResourceDefs.xml",
    "type": "ThingDef",
    "defName": "EggMegabeeFertilized",
    "xpath": "description",
    "key": "EggMegabeeFertilized.description",
    "english": "A fertilized megabee egg. If all goes well, it should hatch into a baby megabee. It can be eaten raw, but it's much better cooked."
  },
  {
    "file": "Mod/Defs/ResourceDefs.xml",
    "type": "ThingDef",
    "defName": "MegabeeTallow",
    "xpath": "label",
    "key": "MegabeeTallow.label",
    "english": "megabee tallow"
  },
  {
    "file": "Mod/Defs/ResourceDefs.xml",
    "type": "ThingDef",
    "defName": "MegabeeTallow",
    "xpath": "description",
    "key": "MegabeeTallow.description",
    "english": "A close relative of giant insect jelly, produced by Megabees. It maintains a somewhat thin consistency until exposed to open air, at which point the outermost layers of the substance gelatinize, making storage remarkably trivial. On worlds capable of raising them, children often snack on large handfuls of \"Megabee Geysers\", which are small dollops of Megabee Tallow allowed to solidify into small candies with a chewy outside and liquid tallow within. It has antimicrobial properties, meaning it will never cause food poisoning, and it can even be fashioned into a salve of similar effectiveness to healroot extract."
  },
  {
    "file": "Mod/Defs/ResourceDefs.xml",
    "type": "ThingDef",
    "defName": "WoolMegabee",
    "xpath": "label",
    "key": "WoolMegabee.label",
    "english": "megabee wool"
  },
  {
    "file": "Mod/Defs/ResourceDefs.xml",
    "type": "ThingDef",
    "defName": "WoolMegabee",
    "xpath": "description",
    "key": "WoolMegabee.description",
    "english": "A stiff, fibrous psuedo-wool harvested from Megabees. Though it's not particularly soft, it has fair all-around temperature regulation and is resistant to heat. It's a good material for clothing or structures thanks to its rather incredible durability, and the sheer bounty of it that can be shorn from even a single megabee."
  },
  {
    "file": "Mod/Defs/salveDefs.xml",
    "type": "ThingDef",
    "defName": "MedicineMegabee",
    "xpath": "label",
    "key": "MedicineMegabee.label",
    "english": "megabee tallow salve"
  },
  {
    "file": "Mod/Defs/salveDefs.xml",
    "type": "ThingDef",
    "defName": "MedicineMegabee",
    "xpath": "description",
    "key": "MedicineMegabee.description",
    "english": "A salve produced from the fur and tallow of a Megabee. The antimicrobial properties of the tallow make it almost as effective as healroot, while being far more readily available if the colony has access to a megabee."
  }
]
