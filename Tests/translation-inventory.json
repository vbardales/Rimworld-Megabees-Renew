  },
  {
    "file": "Mod/Defs/ResourceDefs.xml",
    "type": "ThingDef",
    "defName": "EggMegabeeUnfertilized",
    "xpath": "description",
    "key": "EggMegabeeUnfertilized.description",
    "english": "An unfertilized megabee egg. It can be eaten raw, but it's much, much better cooked. These human-torso-sized eggs are somewhat unappetizing, but can feed a small family all by themselves."
  },
  {
